# Copy to .env and adjust. Values below are for local development only: never reuse them elsewhere.
# Every variable read by the stack or the application must be documented here.

# --- API process (api/settings.py) ---
# Minimum level of the JSON logs written to stdout: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
# Service name attached to every trace span.
OTEL_SERVICE_NAME=proofpoint-api
# Host port for the API, bound on 127.0.0.1.
API_PORT=8000

# --- PostgreSQL (deploy/docker-compose.yml) ---
# Database superuser created on first start.
POSTGRES_USER=proofpoint
# Password of POSTGRES_USER.
POSTGRES_PASSWORD=dev-only-postgres-password
# Database created on first start.
POSTGRES_DB=proofpoint
# Host port bound on 127.0.0.1.
POSTGRES_PORT=5432

# --- Valkey (Redis-compatible queue and cache) ---
# Password required by every client (requirepass).
VALKEY_PASSWORD=dev-only-valkey-password
# Host port bound on 127.0.0.1.
VALKEY_PORT=6379

# --- S3-compatible object storage (SeaweedFS in development) ---
# Access key of the admin identity.
S3_ACCESS_KEY_ID=dev-only-access-key
# Secret key of the admin identity.
S3_SECRET_ACCESS_KEY=dev-only-secret-key
# Bucket created on startup; holds uploaded source documents.
S3_BUCKET=proofpoint-documents
# Host port of the S3 endpoint, bound on 127.0.0.1.
S3_PORT=8333

# --- Qdrant (vector and sparse index) ---
# API key required on every request except health endpoints.
QDRANT_API_KEY=dev-only-qdrant-api-key
# Host port of the HTTP API, bound on 127.0.0.1.
QDRANT_PORT=6333
